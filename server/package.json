{
  "name": "treatment-plan-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend API: app auth (email/password + JWT, roles/teams) and Zoho CRM integration (server-side OAuth, per-user deals).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prestart": "node dist/migrate.js up",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts up",
    "migrate:status": "tsx src/migrate.ts status",
    "role": "tsx src/scripts/set-role.ts",
    "team": "tsx src/scripts/manage-team.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
