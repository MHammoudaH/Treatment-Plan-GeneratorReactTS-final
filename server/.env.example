# ---------------------------------------------------------------------------
# Treatment Plan Generator — backend configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# HTTP port the API listens on.
PORT=8787

# Where the React app is served from during development. Used for CORS and as
# the destination the Zoho callback redirects the browser back to.
APP_ORIGIN=http://localhost:5173

# Secret used to sign session JWTs. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-change-me

# How long an app session stays valid.
SESSION_TTL_DAYS=7

# PostgreSQL connection string. Standard "DATABASE_URL" used by Render/Heroku/etc.
# NEVER commit a real DATABASE_URL (it contains credentials) — this file is the
# example; the real value goes in `.env` (git-ignored) or the host's dashboard.
# Local dev example (matches `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/treatment_plan
# After setting this, create the schema with:  npm run migrate

# Set to 1 on managed hosts that require TLS (Render, Heroku, Supabase, Neon...).
# Leave unset/0 for a local Postgres without SSL.
DATABASE_SSL=0

# Max connections in the pool (optional).
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Zoho CRM
# ---------------------------------------------------------------------------
# Data-center hosts. Defaults are the US (.com) data center.
#   EU:  https://accounts.zoho.eu   / https://www.zohoapis.eu
#   IN:  https://accounts.zoho.in   / https://www.zohoapis.in
#   AU:  https://accounts.zoho.com.au / https://www.zohoapis.com.au
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com

# OAuth client from the Zoho API console (https://api-console.zoho.com/).
# Create a "Server-based Applications" client and set its Authorized Redirect URI
# to exactly the ZOHO_REDIRECT_URI below.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Must match an Authorized Redirect URI on the Zoho client, character for character.
ZOHO_REDIRECT_URI=http://localhost:8787/api/zoho/callback

# OAuth scopes requested during consent.
ZOHO_SCOPES=ZohoCRM.modules.deals.READ,ZohoCRM.users.READ,ZohoCRM.settings.READ

# OPTIONAL: if you already generated a refresh token (e.g. via a Self Client),
# put it here and the server will use it without needing the browser consent flow.
ZOHO_REFRESH_TOKEN=

# OPTIONAL: restrict who can sign up. Comma-separated list of allowed email
# domains, e.g. "dutyclinic.com,example.org". Empty = anyone can sign up.
SIGNUP_ALLOWED_DOMAINS=
